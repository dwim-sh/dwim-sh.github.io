Output demo-full.gif
Set Shell "bash"
Set FontSize 15
Set Width 720
Set Height 510
Set Padding 24
Set WindowBar Colorful
Set WindowBarSize 36
Set Theme { "name": "dwim", "background": "#161615", "foreground": "#ecece6", "cursor": "#ecece6", "black": "#161615", "brightBlack": "#8a8a83", "red": "#ff5f57", "green": "#3ec98a", "yellow": "#febc2e", "blue": "#7aa2f7", "magenta": "#c678dd", "cyan": "#56b6c2", "white": "#ecece6", "brightRed": "#ff5f57", "brightGreen": "#3ec98a", "brightYellow": "#febc2e", "brightBlue": "#7aa2f7", "brightMagenta": "#c678dd", "brightCyan": "#56b6c2", "brightWhite": "#ffffff" }
Hide
Type "clear; asciinema play -q hello-demo.cast"
Enter
Sleep 400ms
Show
Sleep 12.95s
